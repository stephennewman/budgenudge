NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_UPDATE_PUBLISHABLE_KEY=
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=http://localhost:3000/api/plaid/webhook
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
RESEND_API_KEY=your_resend_api_key_here
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here

# Shared secret required by cron endpoints (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=your_cron_secret_here

# Recipient phone for the daily Boat Outlook text (Palm Harbor)
BOAT_OUTLOOK_PHONE=+15551234567

# User ID granted superadmin access (Feed, admin/debug endpoints).
# NEXT_PUBLIC_ so server and client components resolve the same value.
NEXT_PUBLIC_SUPERADMIN_USER_ID=

# Mirror dashboard (/mirror)
# Shared secret required to show the private "spent yesterday" card on the
# public dashboard. Leave blank to hide the finance card entirely.
MIRROR_TOKEN=
# Optional: which user's spend to show (defaults to NEXT_PUBLIC_SUPERADMIN_USER_ID).
MIRROR_FINANCE_USER_ID=
# Optional: RSS feed for the news headlines card (defaults to NPR top stories).
MIRROR_NEWS_FEED=
# Optional: override the "Extra Fun" per-person passcodes (4 digits each).
EXTRA_FUN_CODE_STEPHEN=
EXTRA_FUN_CODE_WHITNEY=
# Optional: "Now showing" card. TMDB (free) lists movies in theaters + trending TV.
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional: OMDb (free) adds Rotten Tomatoes critics scores to the movie posters.
# Get a key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Optional: "Out & About" card. Ticketmaster Discovery (free) lists nearby
# events (concerts, games, shows). Get a key at https://developer.ticketmaster.com
TICKETMASTER_API_KEY=
# Optional: SeatGeek adds independent venues Ticketmaster misses (Jannus Live,
# etc.). Register an app at https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=

# Florida launch calendar (/launches)
# Optional. When set, the leftover iCalendar feed requires ?key=<token>.
LAUNCH_FEED_TOKEN=
# How many upcoming launches to email on subscribe (default 5). Already-sent
# invites are always kept accurate, even after a launch slips past this cutoff.
LAUNCH_INVITE_COUNT=

# Red Fern Plantation demo (/red-fern, /red-fern/schedule)
# House code for the section as a whole: nothing under /red-fern or
# /api/red-fern answers without it, so the demo can sit on a public deploy
# without being findable. Unset, the demo uses "redfern" and says so on the
# gate. Change this before sharing the link with anyone outside.
RED_FERN_SITE_CODE=
# Code that opens the private schedule page and signs the iCalendar feed.
# Unset, the demo uses "redfern" and says so on the gate.
RED_FERN_SCHEDULE_CODE=
# From: address for booking confirmations. Defaults to the same verified
# mailbox as launch invites (alerts@krezzo.com). Override only with another
# address on a domain verified with Resend.
RED_FERN_FROM_EMAIL=

# Feature flags
# Disable 4:15/5pm SMS without removing the cron
SMS_415PM_ENABLED=false

# Allowlist user IDs for v2 daily snapshot rollout (comma-separated)
ALLOWED_DAILY_V2_USER_IDS=
